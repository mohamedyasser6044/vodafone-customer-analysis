{
  "name": "Vodafone",
  "dataColors": [
    "#E60000",
    "#4A4D4E",
    "#8A8D8E",
    "#C9CBCC",
    "#007C00",
    "#25282B"
  ],
  "foreground": "#25282B",
  "background": "#FFFFFF",
  "tableAccent": "#E60000",
  "good": "#007C00",
  "bad": "#E60000",
  "neutral": "#8A8D8E",
  "textClasses": {
    "callout": {
      "fontSize": 18,
      "fontFace": "Segoe UI Bold",
      "color": "#25282B"
    },
    "title": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#25282B"
    },
    "header": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#25282B"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#5F6366"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "page": {
      "*": {
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F4F4"
              }
            }
          }
        ]
      }
    }
  }
}